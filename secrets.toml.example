# Template only. Paste the real values into Streamlit Cloud -> app Settings -> Secrets
# (or, for local use, save as .streamlit/secrets.toml, which is git-ignored).
# Values come from your service account's credentials.json.

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "pgg-logger@your-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
